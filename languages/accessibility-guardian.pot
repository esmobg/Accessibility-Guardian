msgid "Add a meaningful alt attribute describing the image purpose. Use alt=\"\" for purely decorative images."
msgstr ""

#: src/Rules/RuleCatalog.php:171
msgid "Add an alt attribute to the image input describing the button action."
msgstr ""

#: src/Rules/RuleCatalog.php:178
msgid "Remove redundant text that duplicates adjacent visible text or the alt value."
msgstr ""

#: src/Rules/RuleCatalog.php:185
msgid "Provide an accessible name for the SVG via <title>, aria-label, or role=\"img\" with a label."
msgstr ""

#: src/Rules/RuleCatalog.php:192
msgid "Provide alternative text for the <object> element."
msgstr ""

#: src/Rules/RuleCatalog.php:199
msgid "Add alt text to each <area> within an image map."
msgstr ""

