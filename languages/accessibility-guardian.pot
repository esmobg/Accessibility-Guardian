msgid "Add labels to search forms"
msgstr ""

#: src/Rules/RuleCatalog.php:93
msgid "Adds an accessible label to the default search form field (WCAG 3.3.2)."
msgstr ""

#: src/Rules/RuleCatalog.php:96
msgid "Remove redundant title attributes"
msgstr ""

#: src/Rules/RuleCatalog.php:97
msgid "Strips title attributes from links and inputs that already have visible text."
