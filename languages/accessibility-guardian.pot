#: src/Rules/RuleCatalog.php:251
#: src/Rules/RuleCatalog.php:563
msgid "2.4.4 Link Purpose (In Context)"
msgstr ""

#: src/Rules/RuleCatalog.php:240
msgid "Provide descriptive link text or an accessible name (aria-label) that conveys the link purpose."
msgstr ""

#: src/Rules/RuleCatalog.php:244
msgid "1.4.1 Use of Color"
msgstr ""

#: src/Rules/RuleCatalog.php:247
msgid "Distinguish links from surrounding text using more than color (for example, an underline)."
msgstr ""

#: src/Rules/RuleCatalog.php:254
msgid "Links with identical names should point to the same destination, or be given distinct accessible names."
msgstr ""

#: src/Rules/RuleCatalog.php:260
#: src/Rules/RuleCatalog.php:267
#: src/Rules/RuleCatalog.php:274
#: src/Rules/RuleCatalog.php:570
msgid "3.3.2 Labels or Instructions"
msgstr ""

#: src/Rules/RuleCatalog.php:263
msgid "Associate a visible <label> with the form control using for/id, or add an aria-label."
msgstr ""

#: src/Rules/RuleCatalog.php:270
msgid "Provide a real label; do not rely solely on the title attribute."
msgstr ""

#: src/Rules/RuleCatalog.php:277
msgid "Ensure each form field is associated with a single label."
msgstr ""

#: src/Rules/RuleCatalog.php:281
msgid "1.3.5 Identify Input Purpose"
msgstr ""

#: src/Rules/RuleCatalog.php:284
msgid "Use a valid autocomplete token appropriate for the input purpose."
