{
    "name": "accessibility-guardian/accessibility-guardian",
    "description": "Automated WCAG 2.2 AA accessibility auditor for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AccessibilityGuardian\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AccessibilityGuardian\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
