{
    "name": "accessibility-guardian/accessibility-guardian",
    "description": "Automated WCAG 2.2 AA accessibility auditor for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "psr-4": {
            "AccessibilityGuardian\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AccessibilityGuardian\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src templates tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
